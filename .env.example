# SQLite database file location
DATABASE_PATH=./data/cms.db

# Secret used to sign NextAuth JWT session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-random-32-byte-secret

# 32-byte AES-256-GCM key used to encrypt tenant-provided third-party secrets
# (e.g. Cloudinary api_secret) at rest. Generate one with: openssl rand -base64 32
# Losing or rotating this key makes every previously stored secret unrecoverable —
# back it up like any other production credential.
MEDIA_CONFIG_ENCRYPTION_KEY=replace-me-with-a-random-32-byte-key
